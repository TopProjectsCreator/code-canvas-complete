{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "railway": {
      "type": "remote",
      "url": "https://mcp.railway.com"
    }
  },
  "provider": {
    "opencode": {
      "models": {
        "deepseek-v4-flash-free": {
          "limit": {
            "context": 1048576,
            "output": 384000
          }
        },
        "mimo-v2.5-free": {
          "limit": {
            "context": 1050000,
            "output": 131100
          }
        }
      }
    }
  }
}
